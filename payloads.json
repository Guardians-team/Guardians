{
    "description": "Passive detection indicators only.",
    "reflection_marker": "SAFE_REFLECTION_CHECK_2026",
    "sql_error_signatures": [
        {
            "label": "SQL syntax error",
            "pattern": "SQL syntax.*(error|near)"
        },
        {
            "label": "Database exception",
            "pattern": "(database|db) (query|connection) (error|failed)"
        },
        {
      "label": "SQLite error",
      "pattern": "sqlite3?\\.OperationalError|unrecognized token|no such column"
    }
    ],
    "security_headers": {
        "Content-Security-Policy": "콘텐츠 보안 정책 확인",
        "X-Content-Type-Options": "MIME 타입 스니핑 방지 설정 확인",
        "Referrer-Policy": "Referrer 정보 전달 정책 확인"
    }
}